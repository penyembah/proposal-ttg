% Lokalisasi bahasa Indonesia (parsial) untuk biblatex, mewarisi english
\ProvidesFile{indonesian.lbx}[2026/09/09 Indonesian localization for biblatex]

\InheritBibliographyExtras{english}
\InheritBibliographyStrings{english}

\DeclareBibliographyStrings{%
  andothers = {{dkk\adddot}{dkk\adddot}},
  and       = {{dan}{dan}},
  in        = {{dalam}{dalam}},
  editor    = {{editor}{ed\adddot}},
  editors   = {{editor}{ed\adddot}},
  volume    = {{jilid}{jil\adddot}},
  number    = {{nomor}{no\adddot}},
  page      = {{halaman}{hlm\adddot}},
  pages     = {{halaman}{hlm\adddot}},
  urlseen   = {{diakses pada}{diakses}},
}
